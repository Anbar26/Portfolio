# Portfolio assistant ("Ask about me").
#
# Copy this file to `.env.local` and fill in the key. `.env.local` is gitignored
# — never commit a real key, and never rename this to a NEXT_PUBLIC_* variable:
# that prefix ships the value to the browser.
#
# Used only by src/app/api/chat/route.ts, which runs on the server.
#
# Free key, no card needed: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Only set this if the default model name stops working — Google
# retires and renames models on its own schedule. To see what your key can
# reach:
#   curl -H "x-goog-api-key: YOUR_KEY" https://generativelanguage.googleapis.com/v1beta/models
# GEMINI_MODEL=gemini-2.5-flash
