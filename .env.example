# Portfolio assistant ("Ask about me").
#
# Copy this file to `.env.local` and fill in the key. `.env.local` is gitignored
# by Next.js — never commit a real key, and never rename this to a
# NEXT_PUBLIC_* variable: that prefix ships the value to the browser.
#
# Used only by src/app/api/chat/route.ts, which runs on the server.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=
